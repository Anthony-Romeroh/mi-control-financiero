# Copia este archivo a .env.local y rellena con tus valores

# Supabase URL - Cambia esto por tu URL de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon Key - Tu clave publica de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Notas:
# - NEXT_PUBLIC_ significa que es accesible desde el frontend
# - Nunca incluyas tu secret key (solo la anon key)
# - Este archivo debe estar en .gitignore